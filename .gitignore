# Local credentials and runtime state must never enter Git.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx
.git-credentials
.config/gh/
.ssh/
# Installed dependencies and disposable output.
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
dist/
artifacts/
*.log
*.zip
# Personal exports are not application source.
*kitchen-backup*.json
*workspace-backup*.json
# This release intentionally uses device-local fallback fonts.
*.woff
*.woff2
*.ttf
*.otf
*.eot
